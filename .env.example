# Supabase (set these per environment: local/preview = dev project, production = prod project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CALENDAR_PACK_REFRESH_SECRET=
# NEVER add service_role keys to frontend env files.

# Optional runtime/site helpers
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# Stripe (server-side only except app URL)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Local billing UX test mode (development only; ignored outside NODE_ENV=development)
NEXT_PUBLIC_BILLING_TEST_MODE=false
NEXT_PUBLIC_BILLING_TEST_PLAN=free

# Environment badge
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SHOW_ENV_BADGE=true

# QA (DEV only; never prefix secrets with NEXT_PUBLIC_)
QA_BASE_URL=
QA_ALLOWED_ORIGIN_PATTERN=^https://doze52-[a-z0-9-]+-conrados-projects-843a6c32\.vercel\.app$
QA_SUPABASE_PROJECT_REF=jbdukjmbtffcgklsxjml
QA_BROWSER_EMAIL=qa.browser@doze52.test
